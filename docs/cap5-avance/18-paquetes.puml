package "lib/models" as M
package "lib/services" as S
package "lib/repositories" as R
package "lib/utils" as U
package "lib/widgets" as W
package "SDK / plugins externos" as EXT
package "supabase/functions\n+ _shared" as F
MAIN ..> V
MAIN ..> C
MAIN ..> S
MAIN ..> R
V ..> C
V ..> S
V ..> R
V ..> M
V ..> W
V ..> EXT : TeacherHomeView: consultas directas
